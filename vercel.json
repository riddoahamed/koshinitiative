{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "koshbd.com"
        }
      ],
      "destination": "https://www.koshbd.com/:path*",
      "permanent": true
    },
    {
      "source": "/investkorsi/:path+",
      "destination": "https://app.koshbd.com/investkorsi/:path*",
      "permanent": false
    },
    {
      "source": "/tv",
      "destination": "/tv/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/tv/",
      "destination": "https://kosh-live-tv.vercel.app/tv/"
    },
    {
      "source": "/tv/:path*",
      "destination": "https://kosh-live-tv.vercel.app/tv/:path*"
    },
    {
      "source": "/rsvp",
      "destination": "https://kosh-rsvp.vercel.app/"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tv/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
