{
  "redirects": [
    {
      "source": "/bd/investkorsi/:path+",
      "destination": "https://app.koshbd.com/investkorsi/:path*",
      "permanent": false
    },
    {
      "source": "/bd/tv",
      "destination": "/bd/tv/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bd/tv/",
      "destination": "https://kosh-live-tv.vercel.app/tv/"
    },
    {
      "source": "/bd/tv/:path*",
      "destination": "https://kosh-live-tv.vercel.app/tv/:path*"
    },
    {
      "source": "/bd/rsvp",
      "destination": "https://kosh-rsvp.vercel.app/"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/bd/tv/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "cleanUrls": true
}
